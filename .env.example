# Server Configuration
PORT=3000
NODE_ENV=production

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
# Model override (defaults to gpt-5-mini). Change if you prefer gpt-5.1-mini, gpt-5-nano, etc.
OPENAI_MODEL=gpt-5-mini
MICROSOFT_TRANSLATOR_KEY=your_microsoft_translator_key_here
MICROSOFT_TRANSLATOR_REGION=southeastasia

# Security
ALLOWED_ORIGINS=chrome-extension://your-extension-id,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
