# Server Configuration
PORT=3000
NODE_ENV=production

# Primary translator — OpenAI-compatible chat completions endpoint.
# Base URL should expose /chat/completions (standard OpenAI path).
TRANSLATOR_BASE_URL=https://your-openai-compatible-host/v1
TRANSLATOR_API_KEY=your_translator_api_key_here
TRANSLATOR_MODEL=your-model-name
# Primary translator request timeout in ms (default 45000). Longer text can take
# 20-40s on some LLM endpoints; raise this to reduce premature fallback to Google.
TRANSLATOR_TIMEOUT_MS=45000

# Security
ALLOWED_ORIGINS=chrome-extension://your-extension-id,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
