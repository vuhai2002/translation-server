# Production env for translation-server (VPS 103.77.240.24, Caddy host port 3002).
# On the VPS: cp .env.production.example .env.production && chmod 600 .env.production
# NEVER commit the real .env.production.

# Server (internal container port; Caddy publishes 127.0.0.1:3002 -> this)
PORT=3000
NODE_ENV=production

# Primary translator - OpenAI-compatible chat completions endpoint.
# Base URL should expose /chat/completions (standard OpenAI path).
TRANSLATOR_BASE_URL=https://your-openai-compatible-host/v1
TRANSLATOR_API_KEY=your_translator_api_key_here
TRANSLATOR_MODEL=your-model-name

# Security
ALLOWED_ORIGINS=chrome-extension://your-extension-id
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
